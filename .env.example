# AWS 배포용 자격 증명. 이 파일을 복사해 .env 로 만들고 값을 채우세요.
#   cp .env.example .env
# .env 는 .gitignore 에 포함되어 있어 커밋되지 않습니다.

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# 임시 자격 증명(STS/SSO)일 때만 필요
AWS_SESSION_TOKEN=
AWS_DEFAULT_REGION=ap-northeast-2

# SAM 배포 설정
STACK_NAME=jiwoo1st-api
# CORS 허용 origin (GitHub Pages 주소)
ALLOWED_ORIGIN=https://khwook.github.io

# 관리용 비밀 키 (참석자 명단 조회, 방명록 삭제). 아무 긴 문자열이나 넣으세요.
ADMIN_KEY=
